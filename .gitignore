# Fichiers de l'éditeur
.vscode/
.idea/

# Logs
*.log

# Dépendances
/vendor/
/node_modules/

# Fichiers temporaires
*.tmp
*.bak

# Fichiers de configuration sensibles (mots de passe, clés API)
/config/mongodb.php
/config/database.php
/config/*.secret.php

# Fichier d'environnement (credentials BDD - ne JAMAIS commiter)
/config/.env
/config/.env.local

# Garder .env.example dans Git pour servir de modèle
!/config/.env.example

# Fichiers de notes personnelles
notes-mongodb.txt
notes-*.txt

# Variables d'environnement à la racine
.env
.env.local
.env.*.local

# Fichiers de test temporaires
test-mongodb.php
test-*.php

# Fichiers système macOS / Windows
.DS_Store
Thumbs.db